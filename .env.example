APP_API_TOKEN=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
VITE_API_TOKEN=# Required for every API request (set the same value in APP_API_TOKEN and VITE_API_TOKEN)
APP_API_TOKEN=change-this-to-a-long-random-token
VITE_API_TOKEN=change-this-to-the-same-token
# Render persistent disk; leave unset locally to use ./data
PERSIST_DIR=./data
